{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Robot Analyzer",
  "version": "0.1.0",
  "identifier": "org.robotanalyzer.workstation",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Robot Analyzer", "width": 1280, "height": 720, "minWidth": 840, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "skip" } }
  }
}
